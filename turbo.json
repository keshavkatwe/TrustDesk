{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [".env", "tsconfig.base.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["API_PORT", "WEB_ORIGIN", "VITE_API_URL"]
    },
    "openapi:export": {
      "dependsOn": ["transit"],
      "outputs": ["openapi.json"]
    },
    "api:generate": {
      "dependsOn": ["@trustdesk/api#openapi:export"],
      "outputs": ["src/api/**"]
    },
    "db:generate": { "cache": false },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL", "STUDIO_TENANT_ID"]
    },
    "db:migrate": { "cache": false, "env": ["DATABASE_ADMIN_URL"] },
    "queue:setup": {
      "dependsOn": ["@trustdesk/db#db:migrate"],
      "cache": false,
      "env": ["DATABASE_ADMIN_URL"]
    },
    "db:seed": { "cache": false, "env": ["DATABASE_ADMIN_URL"] },
    "db:test": { "cache": false, "env": ["DATABASE_TEST_URL", "DATABASE_TEST_ADMIN_URL"] },
    "inbox:seed": {
      "dependsOn": ["@trustdesk/db#db:seed"],
      "cache": false,
      "env": ["DATABASE_ADMIN_URL"]
    },
    "inbox:test": {
      "dependsOn": ["@trustdesk/db#db:test"],
      "cache": false,
      "env": ["DATABASE_TEST_URL", "DATABASE_TEST_ADMIN_URL"]
    },
    "@trustdesk/api#dev": {
      "cache": false,
      "persistent": true,
      "env": ["API_PORT", "WEB_ORIGIN", "DATABASE_URL", "OPENAI_API_KEY", "OPENAI_MODEL"]
    },
    "@trustdesk/worker#dev": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL", "OPENAI_API_KEY", "OPENAI_MODEL"]
    },
    "@trustdesk/web#dev": {
      "dependsOn": ["api:generate"],
      "cache": false,
      "persistent": true,
      "env": ["VITE_API_URL"]
    },
    "@trustdesk/web#typecheck": {
      "dependsOn": ["transit", "api:generate"],
      "outputs": []
    },
    "@trustdesk/web#build": {
      "dependsOn": ["^build", "api:generate"],
      "outputs": ["dist/**"],
      "env": ["VITE_API_URL"]
    }
  }
}
