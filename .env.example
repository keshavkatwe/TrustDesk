# Optional overrides for the local development defaults.
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000

# Optional: server-only AI drafting. Never prefix this key with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17

# Local Compose database. Credentials are for this loopback-only development setup.
POSTGRES_PORT=5433
DATABASE_URL=postgres://trustdesk_app:trustdesk_local_app@127.0.0.1:5433/trustdesk
DATABASE_ADMIN_URL=postgres://trustdesk_migrator:trustdesk_local_migrator@127.0.0.1:5433/trustdesk
DATABASE_TEST_URL=postgres://trustdesk_app:trustdesk_local_app@127.0.0.1:5433/trustdesk_test
