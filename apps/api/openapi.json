    "/workspace": {
      "get": {
        "operationId": "getWorkspace",
        "tags": [
          "inbox"
        ],
        "summary": "Businesses available to the local operator (no production login)",
        "responses": {
          "200": {
            "description": "Response for status 200",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "tenants": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "enum": [
                              "qamar",
                              "rimal"
                            ]
                          },
                          "name": {
                            "type": "string"
                          },
                          "shortName": {
                            "type": "string"
                          },
                          "location": {
                            "type": "string"
                          },
                          "timezone": {
                            "type": "string"
                          },
                          "currency": {
                            "type": "string",
                            "enum": [
                              "AED",
                              "SAR"
                            ]
                          },
                          "trust": {
                            "type": "string",
                            "const": "supervised"
                          },
                          "autoSend": {
                            "type": "string",
                            "enum": [
                              "low_risk_only",
                              "off"
                            ]
                          },
                          "approvers": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string"
                                },
                                "name": {
                                  "type": "string"
                                },
                                "role": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "id",
                                "name",
                                "role"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "shortName",
                          "location",
                          "timezone",
                          "currency",
                          "trust",
                          "autoSend",
                          "approvers"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "tenants"
                  ],
                  "additionalProperties": false
                }
