{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "bun-types"],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    // Hey API's generated client uses optional properties that may explicitly be undefined.
    "exactOptionalPropertyTypes": false
  },
  "include": ["src", "vite.config.ts", "openapi-ts.config.ts"]
}
